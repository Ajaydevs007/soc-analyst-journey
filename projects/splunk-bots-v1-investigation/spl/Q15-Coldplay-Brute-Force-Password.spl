###############################################################
# Q15 - Coldplay Song Used as Brute Force Password
###############################################################

# Step 1 - Identify password attempts

index=botsv1
sourcetype="stream:http"
http_method=POST
form_data="*username*passwd*"

# Step 2 - Extract password

index=botsv1
sourcetype="stream:http"
http_method=POST
form_data="*username*passwd*"
| rex field=form_data "passwd=(?<password>[^&]+)"
| table _time password

# Step 3 - Filter six-character passwords

index=botsv1
sourcetype="stream:http"
http_method=POST
form_data="*username*passwd*"
| rex field=form_data "passwd=(?<password>[^&]+)"
| eval password_length=len(password)
| where password_length=6
| stats count by password
| sort password

# Step 4 - Optional Coldplay lookup

index=botsv1
sourcetype="stream:http"
http_method=POST
form_data="*username*passwd*"
| rex field=form_data "passwd=(?<password>[^&]+)"
| eval password_length=len(password)
| where password_length=6
| eval password=lower(password)
| lookup coldplay.csv song_title as password OUTPUTNEW song_title as match
| where isnotnull(match)
| table password match

# Result:
# yellow